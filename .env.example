# Bekaye Sora Manager — modèle de variables d'environnement
# Copier ce fichier en `.env` et renseigner les valeurs. Ne jamais commiter `.env`.

# --- Base de données / API (exposées au navigateur, clés publiables uniquement) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Côté serveur uniquement (SSR / fonctions serveur) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Clé de service : privilèges administrateur, contourne le RLS.
# À définir uniquement sur le serveur d'hébergement, jamais dans le dépôt.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optionnel : passerelle IA / intégrations ---
LOVABLE_API_KEY=
